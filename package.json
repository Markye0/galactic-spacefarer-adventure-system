{
  "name": "spacefarers",
  "version": "1.0.0",
  "type": "module",
  "dependencies": {
    "@sap/cds": "^10"
  },
  "devDependencies": {
    "@cap-js/cds-test": "^1.0.2",
    "@cap-js/cds-typer": ">=0.1",
    "@cap-js/cds-types": "^0.18.0",
    "@cap-js/sqlite": "^3",
    "@types/node": "^24.0.0",
    "eslint": "^10.12.0",
    "tsx": "^4",
    "typescript": "~6.0",
    "typescript-eslint": "^8.71.1"
  },
  "scripts": {
    "start": "cds-serve",
    "watch": "cds watch",
    "types": "cds-typer \"*\" --outputDirectory @cds-models",
    "pretest": "npm run types",
    "test": "node --import tsx --import ./test/setup.ts --test \"test/**/*.test.ts\"",
    "lint": "eslint .",
    "typecheck": "npm run types && tsc"
  },
  "private": true,
  "imports": {
    "#cds-models/*": "./@cds-models/*/index.js"
  },
  "cds": {
    "requires": {
      "auth": {
        "[development]": {
          "kind": "mocked",
          "users": {
            "alice": {
              "password": "pass",
              "roles": [
                "GalacticAdmin"
              ]
            },
            "xavier": {
              "password": "pass",
              "roles": [
                "SpacefarerManager"
              ],
              "attr": {
                "planet": "X"
              }
            },
            "xena": {
              "password": "pass",
              "roles": [
                "SpacefarerViewer"
              ],
              "attr": {
                "planet": "X"
              }
            },
            "yara": {
              "password": "pass",
              "roles": [
                "SpacefarerManager"
              ],
              "attr": {
                "planet": "Y"
              }
            },
            "yuri": {
              "password": "pass",
              "roles": [
                "SpacefarerViewer"
              ],
              "attr": {
                "planet": "Y"
              }
            },
            "nobody": {
              "password": "pass",
              "roles": []
            },
            "*": false
          }
        }
      }
    }
  }
}
